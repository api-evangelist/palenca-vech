{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palenca accounts insights-report API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "insights-report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send Report Content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/insights/reports/:account_id",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Send Report Content"
        },
        {
          "info": {
            "name": "Compute Buro Insights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/insights/:account_id/extended",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Compute Buro Insights"
        },
        {
          "info": {
            "name": "Compute Buro Insights For Pdf",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/insights/:account_id/extended/pdf",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Compute Buro Insights For Pdf"
        }
      ]
    }
  ],
  "bundled": true
}