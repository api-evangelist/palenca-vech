          "request": {
            "name": "Recover Rappi Start Location Last Two Weeks",
            "description": {
              "content": "Recover start_location for Rappi accounts that have delivery events with a missing\nstart_location in the last `days` (default 14). Re-parses stored earnings payloads and\nrefreshes start_location on the existing event rows.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "rappi",
                "start-location",
                "recover",
                "last-two-weeks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "days",
                  "value": "14",
                  "description": "Lookback window in days (default 14)"
                }
              ],
              "variable": []
            },
