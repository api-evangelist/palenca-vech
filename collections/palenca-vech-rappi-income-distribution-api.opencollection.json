{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palenca accounts rappi-income-distribution API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "rappi-income-distribution",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Recover Rappi Income Distribution Custom Range",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/rappi/income-distribution/recover/custom-range",
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date in YYYY-MM-DD format"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date in YYYY-MM-DD format"
              }
            ]
          },
          "docs": "Recover income distribution data for Rappi accounts within a custom date range."
        }
      ]
    }
  ],
  "bundled": true
}